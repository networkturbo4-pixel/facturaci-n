# =============================================================
# FACTUSYS - Plantilla de Variables de Entorno para Producción
# Renombra este archivo a .env en tu servidor de producción
# =============================================================

# Entorno de la Aplicación (production | local | development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com

# Base de Datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=facturacion_crm
DB_USER=factusys_user
DB_PASS=TuPasswordSeguroAqui123!

# Proveedor SUNAT / OSE (Nubefact / Greenter)
# Valores de MODO: produccion | beta
NUBEFACT_MODO=produccion
NUBEFACT_URL=https://api.nubefact.com/api/v1/TU_RUTA_DE_PRODUCCION
NUBEFACT_TOKEN=TU_TOKEN_DE_PRODUCCION_AQUI
